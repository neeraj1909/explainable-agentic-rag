# Required: OpenAI-compatible chat model.
#
# For OpenAI directly, use an OpenAI model name and leave LITELLM_API_BASE empty.
# For a LiteLLM or another OpenAI-compatible proxy, set all three values.
LITELLM_MODEL=
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_STREAMING=true
LITELLM_TIMEOUT_SECONDS=30

# Required by the current local-PDF RAG implementation.
#
# Embeddings use LangChain's OpenAIEmbeddings client separately from the chat
# endpoint. Document chunks are sent to this provider when the index is built.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_API_KEY=
OPENAI_EMBEDDING_TIMEOUT_SECONDS=30

# RAG corpus, future persisted-index location, and retrieval defaults.
#
# RAG_INDEX_DIR is reserved for the persisted index planned later; the current
# implementation still builds an in-memory index for every retriever.
RAG_DOCS_DIR=docs
RAG_INDEX_DIR=.rag-index
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_FETCH_K_MULTIPLIER=4

# Optional embedding-similarity reranker. It is disabled by default and adds
# more embedding requests when enabled.
RAG_USE_RERANKER=false
RAG_RERANKER_EMBEDDING_MODEL=text-embedding-3-small

# Phoenix/OpenTelemetry tracing.
#
# This portable default expects a local Phoenix server on port 6006. Replace it
# with your own collector URL when Phoenix runs elsewhere, or disable tracing
# for offline/test runs.
PHOENIX_ENABLED=true
PHOENIX_PROJECT_NAME=explainable-agentic-rag
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
